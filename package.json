{
  "name": "contactur-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
      "node": "^24.21.0",
      "npm": "^11.19.0"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
